{
  "expo": {
    "name": "WorldClock",
    "slug": "worldclock",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0B0B0F",
    "android": {
      "package": "com.subrahmanyam.worldclock",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0F"
      }
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "WorldClock",
              "label": "WorldClock",
              "description": "Shows your configured time zones at a glance.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/worldclock.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
